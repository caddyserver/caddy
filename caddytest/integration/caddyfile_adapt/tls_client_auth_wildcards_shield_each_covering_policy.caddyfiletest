*.example.com {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file ../caddy.ca.cer
			}
		}
	}
	respond "example wildcard"
}

*.other.com {
	tls {
		client_auth {
			mode require
			trust_pool file {
				pem_file ../caddy.ca.cer
			}
		}
	}
	respond "other wildcard"
}

public.example.com, public.other.com {
	respond "public"
}
