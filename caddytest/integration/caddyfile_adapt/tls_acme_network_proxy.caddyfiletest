localhost

tls {
	issuer acme {
		network_proxy url http://localhost:8080
	}
}
----------
{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"localhost"
									]
								}
							],
							"terminal": true
						}
					]
				}
			}
		},
		"tls": {
			"automation": {
				"policies": [
					{
						"subjects": [
							"localhost"
						],
						"issuers": [
							{
								"module": "acme",
								"network_proxy": {
									"from": "url",
									"url": "http://localhost:8080"
								}
							}
						]
					}
				]
			}
		}
	}
}
