(common) {
	route /api/* {
		respond "api"
	}
}

&(foo) {
	import common
}

localhost:9080 {
	invoke foo
}
----------
{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":9080"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"localhost"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "invoke",
													"name": "foo"
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					],
					"named_routes": {
						"foo": {
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"body": "api",
																	"handler": "static_response"
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"path": [
														"/api/*"
													]
												}
											]
										}
									]
								}
							]
						}
					}
				}
			}
		}
	}
}
