&(a) {
	invoke b
	respond "a"
}

&(b) {
	invoke c
	respond "b"
}

&(c) {
	respond "c"
}

&(loop1) {
	invoke loop2
	respond "loop1"
}

&(loop2) {
	invoke loop1
	respond "loop2"
}

:8080 {
	invoke a
}

:8081 {
	invoke loop1
}
